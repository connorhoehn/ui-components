{
  "version": 1,
  "name": "Work shared UI compact layout",
  "tolerance": 1,
  "rules": [
    {
      "id": "shell.header.count",
      "kind": "count",
      "selector": "$header",
      "expected": 1,
      "owner": "shell"
    },
    {
      "id": "shell.footer.count",
      "kind": "count",
      "selector": "$footer",
      "expected": 1,
      "owner": "shell"
    },
    {
      "id": "shell.header.height",
      "kind": "box",
      "selector": "$header",
      "properties": {
        "height": {
          "min": 40,
          "max": 56
        }
      },
      "owner": "shell"
    },
    {
      "id": "shell.footer.height",
      "kind": "box",
      "selector": "$footerRow",
      "properties": {
        "height": {
          "min": 40,
          "max": 48
        }
      },
      "owner": "SocialFooter"
    },
    {
      "id": "shell.viewport",
      "kind": "viewport",
      "owner": "shell / scroll containment"
    },
    {
      "id": "shell.columns",
      "kind": "columns",
      "selector": "$shellColumns",
      "children": ":scope > aside, :scope > main",
      "min": 2,
      "max": 3,
      "maxGap": 1,
      "required": true,
      "owner": "SubNavLayout"
    },
    {
      "id": "workspace.columns",
      "kind": "columns",
      "selector": "$workspaceColumns",
      "children": ":scope > *",
      "min": 2,
      "max": 3,
      "maxGap": 1,
      "owner": "workspace rail + content layout"
    },
    {
      "id": "subnav.columns",
      "kind": "columns",
      "selector": "$nestedColumns",
      "children": ":scope > aside, :scope > [data-subnav-content]",
      "min": 2,
      "max": 3,
      "maxGap": 1,
      "owner": "SubNavLayout nested rail + content"
    },
    {
      "id": "pane.columns",
      "kind": "columns",
      "selector": "$splitColumns",
      "children": ":scope > [data-testid$='-primary'], :scope > [data-testid$='-secondary']",
      "min": 1,
      "max": 2,
      "maxGap": 8,
      "owner": "SplitPane / SidePane"
    },
    {
      "id": "control.font-family",
      "kind": "text",
      "selector": "$controls",
      "properties": {
        "fontFamily": {
          "from": "body",
          "property": "fontFamily"
        }
      },
      "owner": "Button / IconButton / forms",
      "exclude": [
        {
          "selector": "$keyboardHints",
          "reason": "Keyboard hints use the explicit monospace typography rule"
        },
        {
          "selector": "$decorativeText",
          "reason": "Aria-hidden glyphs are icons rather than readable labels"
        },
        {
          "selector": "$codeLabels",
          "reason": "Code identifiers have their own monospace profile"
        },
        {
          "selector": "[data-ui-code-surface=\"terminal\"] textarea.xterm-helper-textarea",
          "reason": "xterm's hidden input helper inside a marked terminal code surface is not a visible form control"
        }
      ],
      "tolerance": 0.1
    },
    {
      "id": "control.font-size",
      "kind": "text",
      "selector": "$controls",
      "properties": {
        "fontSize": [
          12,
          14
        ]
      },
      "tolerance": 0.1,
      "exclude": [
        {
          "selector": "$railHeaders",
          "reason": "Navigation group captions use their shared rail typography contract"
        },
        {
          "selector": "$tenantControl",
          "reason": "Tenant identity uses the explicit shell brand typography rule"
        },
        {
          "selector": "$tickerControl",
          "reason": "The compact footer ticker uses the explicit ticker typography rule"
        },
        {
          "selector": "$avatarControl",
          "reason": "Avatar initials and overflow counts use the separate avatar readability rule"
        },
        {
          "selector": "$keyboardHints",
          "reason": "Keyboard hints use the explicit compact hint typography rule"
        },
        {
          "selector": "$captions",
          "reason": "Secondary role captions use the explicit caption typography rule"
        },
        {
          "selector": "$decorativeText",
          "reason": "Aria-hidden glyphs are icons rather than readable labels"
        },
        {
          "selector": "$codeLabels",
          "reason": "Code identifiers have their own monospace profile"
        },
        {
          "selector": "$railCaptionLabels",
          "reason": "RailSectionHeader / railType has an explicit 11px profile"
        },
        {
          "selector": "$conversationLabels",
          "reason": "ConversationList has an explicit 13px profile"
        },
        {
          "selector": "$conversationMetadata",
          "reason": "ConversationList has an explicit 11px profile"
        },
        {
          "selector": "$rowMenuGlyphs",
          "reason": "ConversationList has an explicit 13px profile"
        },
        {
          "selector": "$railItemLabels",
          "reason": "GroupedList rail titles use the explicit railType item typography profile; sibling actions remain ordinary controls"
        },
        {
          "selector": "$graphDetailLabels",
          "reason": "WorkActivityNode detail text uses a leaf-only typography profile; neighboring controls remain ordinary"
        },
        {
          "selector": "$graphMetadataLabels",
          "reason": "WorkActivityNode metadata uses a leaf-only typography profile; neighboring controls remain ordinary"
        },
        {
          "selector": "$activePersonCaptions",
          "reason": "ActivePeopleGrid name / More caption uses a leaf-only typography profile; neighboring controls remain ordinary"
        },
        {
          "selector": "[data-ui-code-surface=\"terminal\"] textarea.xterm-helper-textarea",
          "reason": "xterm's hidden input helper inside a marked terminal code surface is not a visible form control"
        }
      ],
      "owner": "Button / IconButton / forms"
    },
    {
      "id": "control.border-style",
      "kind": "style",
      "selector": "$controls",
      "properties": {
        "borderTopStyle": [
          "solid",
          "none"
        ]
      },
      "owner": "Button / IconButton / forms (FileUploadDrop: data-ui-dropzone)",
      "exclude": [
        {
          "selector": "[role=\"button\"][data-ui-dropzone]:not(:has(button, input, select, textarea, [role=\"button\"]))",
          "reason": "A marked drop target's dashed edge is its affordance; the exemption lapses if it hosts a nested control"
        }
      ]
    },
    {
      "id": "toolbar.control-height",
      "kind": "box",
      "selector": "$toolbarControls",
      "properties": {
        "height": {
          "token": "--ui-control-sm"
        }
      },
      "owner": "controlMetrics / CollectionToolbar"
    },
    {
      "id": "collection.gutter",
      "kind": "style",
      "selector": "$collections",
      "properties": {
        "paddingLeft": 0,
        "paddingRight": 0
      },
      "owner": "CollectionPage; shell supplies outer gutter"
    },
    {
      "id": "section.gutter",
      "kind": "style",
      "selector": "$sectionTitles",
      "properties": {
        "paddingLeft": {
          "token": "--ui-page-gutter"
        },
        "paddingRight": {
          "token": "--ui-page-gutter"
        }
      },
      "owner": "SectionHeader"
    },
    {
      "id": "content.gutter",
      "kind": "gutter",
      "selector": "$contentColumns",
      "anchor": "$trail",
      "edges": [
        "left",
        "right"
      ],
      "owner": "SectionContent body inset / the page composing the content column"
    },
    {
      "id": "content.header-alignment",
      "kind": "row-start",
      "selector": "$contentColumns",
      "anchor": "$trail",
      "offset": 0,
      "tolerance": 2,
      "owner": "SectionHeader title band / the conversation header that takes the title slot"
    },
    {
      "id": "content.single-title",
      "kind": "title-count",
      "selector": "$contentColumns",
      "titleSize": 20,
      "expected": 1,
      "owner": "one header per page: SectionHeader title, or the conversation/record header with the title folded into the trail"
    },
    {
      "id": "layout.contained-controls",
      "kind": "contained",
      "selector": "$containedControls",
      "region": "$containmentRegions",
      "owner": "the control's composite (header actions, tab rows, row actions) and its column",
      "scrollers": [
        {
          "selector": "[role=\"tablist\"], :has(> [role=\"tablist\"])",
          "reason": "A tab row that outgrows its column scrolls inside itself (Tabs / ChannelHeader); the row is judged in place of its tabs"
        },
        {
          "selector": ":has(> table)",
          "reason": "A table's own scroller (DataTable) scrolls wide rows; the scroller is judged in place of its cells' controls"
        }
      ]
    },
    {
      "id": "people.sparse-row",
      "kind": "sparse-row",
      "selector": "$tileLists",
      "maxGapRatio": 3,
      "minItems": 3,
      "owner": "ActivePeopleGrid columns (rail: 4; page: fit) / tile grids"
    },
    {
      "id": "toolbar.inset",
      "kind": "style",
      "selector": "$collectionToolbars",
      "properties": {
        "paddingLeft": {
          "token": "--ui-table-inset"
        },
        "paddingRight": {
          "token": "--ui-table-inset"
        }
      },
      "owner": "CollectionToolbar"
    },
    {
      "id": "table.geometry",
      "kind": "table",
      "selector": "$tables",
      "rowHeight": {
        "token": "--ui-table-row"
      },
      "cellInset": {
        "token": "--ui-table-inset"
      },
      "headerFontSize": 12,
      "headerFontWeight": 600,
      "owner": "DataTable / Table",
      "bodyFontSize": 14,
      "bodyFontFamily": {
        "property": "fontFamily",
        "from": "body"
      }
    },
    {
      "id": "composer.surface",
      "kind": "composer",
      "selector": "$composers",
      "input": "[contenteditable='true'], textarea",
      "boundary": "$composerBoundary",
      "inset": {
        "token": "--ui-content-gutter",
        "scope": "element"
      },
      "owner": "ComposerSurface / conversation host"
    },
    {
      "id": "control.native-select",
      "kind": "count",
      "selector": "$nativeSelects",
      "expected": 0,
      "owner": "forms/Select — a raw or hidden <select> (or <input list>/<datalist>) opens the platform's unstyled menu; the only accepted one is Select native={{ reason }} (data-ui-native-select + data-ui-native-reason)",
      "includeHidden": true
    },
    {
      "id": "control.unmarked-listbox",
      "kind": "count",
      "selector": "$unmarkedListboxes",
      "expected": 0,
      "includeHidden": true,
      "owner": "forms/Select, Combobox, menus — a role=\"listbox\" without data-ui-listbox is a hand-rolled dropdown"
    },
    {
      "id": "listbox.option-type",
      "kind": "text",
      "selector": "$listboxOptions",
      "properties": {
        "fontSize": [
          12,
          14
        ]
      },
      "tolerance": 0.1,
      "owner": "forms/Select / Combobox option rows (12/14 scale)"
    },
    {
      "id": "listbox.in-viewport",
      "kind": "in-viewport",
      "selector": "$openListboxes",
      "owner": "forms/Select / Combobox popup placement (flip and clamp)"
    },
    {
      "id": "composer.nesting",
      "kind": "count",
      "selector": "$nestedComposers",
      "expected": 0,
      "owner": "ComposerSurface"
    },
    {
      "id": "dock.clearance",
      "kind": "dock-clearance",
      "selector": "[data-floating-composer-dock][data-placement=\"pinned\"]",
      "ignore": "[role=\"dialog\"], [role=\"menu\"], [role=\"listbox\"], [role=\"tooltip\"], [data-ui-listbox], [data-uic-popover]",
      "owner": "the content column's scroller and the pinned composer dock (FloatingComposerDock / ComposerSurface)"
    },
    {
      "id": "rail.accordion-font",
      "kind": "style",
      "selector": "$railHeaders",
      "properties": {
        "fontFamily": {
          "from": "body",
          "property": "fontFamily"
        },
        "fontWeight": 600,
        "fontSize": 11
      },
      "owner": "SubNavLayout / rail typography"
    },
    {
      "id": "app.font-family",
      "kind": "style",
      "selector": "body",
      "properties": {
        "fontFamily": "system-ui, -apple-system, sans-serif"
      },
      "owner": "shared app typography"
    },
    {
      "id": "identity.font-size",
      "kind": "text",
      "selector": "$tenantControl",
      "properties": {
        "fontSize": 16
      },
      "owner": "TenantSwitcher",
      "tolerance": 0.1
    },
    {
      "id": "ticker.font-size",
      "kind": "text",
      "selector": "$tickerControl",
      "properties": {
        "fontSize": 11,
        "fontWeight": 400
      },
      "owner": "ActivityTicker",
      "tolerance": 0.1
    },
    {
      "id": "avatar.readability",
      "kind": "text",
      "selector": "$avatarControl",
      "properties": {
        "fontSize": {
          "min": 9,
          "max": 16
        }
      },
      "owner": "PresenceAvatars",
      "tolerance": 0.1
    },
    {
      "id": "keyboard.typography",
      "kind": "text",
      "selector": "$keyboardHints",
      "properties": {
        "fontFamily": {
          "contains": "monospace"
        },
        "fontSize": 11
      },
      "owner": "keyboard hint",
      "tolerance": 0.1
    },
    {
      "id": "caption.typography",
      "kind": "text",
      "selector": "$captions",
      "properties": {
        "fontSize": 11
      },
      "owner": "secondary caption",
      "tolerance": 0.1
    },
    {
      "id": "rail.accordion-height",
      "kind": "box",
      "selector": "$railHeaders",
      "properties": {
        "height": 36
      },
      "owner": "SubNavLayout / rail row geometry"
    },
    {
      "id": "rail.disclosure-label",
      "kind": "text",
      "selector": "$railCaptionLabels",
      "properties": {
        "fontSize": 11
      },
      "tolerance": 0.1,
      "owner": "RailSectionHeader / railType"
    },
    {
      "id": "conversation.label",
      "kind": "text",
      "selector": "$conversationLabels",
      "properties": {
        "fontSize": 13
      },
      "tolerance": 0.1,
      "owner": "ConversationList"
    },
    {
      "id": "conversation.metadata",
      "kind": "text",
      "selector": "$conversationMetadata",
      "properties": {
        "fontSize": 11
      },
      "tolerance": 0.1,
      "owner": "ConversationList"
    },
    {
      "id": "conversation.menu-glyph",
      "kind": "text",
      "selector": "$rowMenuGlyphs",
      "properties": {
        "fontSize": 13
      },
      "tolerance": 0.1,
      "owner": "ConversationList"
    },
    {
      "id": "code.typography",
      "kind": "text",
      "selector": "$codeLabels",
      "properties": {
        "fontFamily": {
          "contains": "monospace"
        },
        "fontSize": [
          10,
          11,
          12,
          14
        ]
      },
      "tolerance": 0.1,
      "owner": "code identifier / inline code"
    },
    {
      "id": "rail.item-label",
      "kind": "text",
      "selector": "$railItemLabels",
      "properties": {
        "fontSize": 13,
        "fontWeight": "500",
        "lineHeight": 20
      },
      "tolerance": 0.1,
      "owner": "GroupedList / railType"
    },
    {
      "id": "composer.presence",
      "kind": "composer-presence",
      "selector": "$composers",
      "owner": "page composition / contextual composer policy",
      "input": "[contenteditable=\"true\"], textarea, [role=\"textbox\"]"
    },
    {
      "id": "graph.detail",
      "kind": "text",
      "selector": "$graphDetailLabels",
      "properties": {
        "fontSize": 11
      },
      "tolerance": 0.1,
      "owner": "WorkActivityNode detail text"
    },
    {
      "id": "graph.metadata",
      "kind": "text",
      "selector": "$graphMetadataLabels",
      "properties": {
        "fontSize": 10
      },
      "tolerance": 0.1,
      "owner": "WorkActivityNode metadata"
    },
    {
      "id": "people.active-caption",
      "kind": "text",
      "selector": "$activePersonCaptions",
      "properties": {
        "fontSize": 11,
        "fontWeight": "500"
      },
      "tolerance": 0.1,
      "owner": "ActivePeopleGrid name / More caption"
    },
    {
      "id": "record.popout",
      "kind": "record-popout",
      "owner": "collection record routing: ListRailLayout list rail + content column, or a SidePane tab",
      "selector": "[role=\"dialog\"], [role=\"alertdialog\"], dialog[open], [data-ui-dialog]",
      "allow": [
        "[role=\"alertdialog\"]",
        "[data-ui-dialog=\"confirm\"]",
        "[data-ui-dialog=\"command-help\"]"
      ]
    },
    {
      "id": "collection.row-activatable",
      "kind": "row-activatable",
      "owner": "DataTable onRowClick (or a row link) / staticRows reason",
      "selector": "$collectionTables"
    },
    {
      "id": "collection.selection-shift",
      "kind": "selection-shift",
      "owner": "CollectionToolbar selection (in place of the resting controls)"
    },
    {
      "id": "popover.fit",
      "kind": "popover-fit",
      "selector": "$popovers",
      "trigger": "[aria-expanded=\"true\"][aria-haspopup]",
      "header": "h2, h3, [role=\"tablist\"]",
      "margin": 0,
      "owner": "InlinePopover placement (flip/clamp, re-anchor on growth) + the panel's own height cap (NotificationBell)"
    },
    {
      "id": "panel.inset",
      "kind": "panel-inset",
      "selector": "$panels",
      "header": "h1, h2, h3, [role=\"heading\"]",
      "tolerance": 2,
      "owner": "the anchored panel's sections (NotificationCenter feed/empty state, popover bodies): every block at the header's inset"
    },
    {
      "id": "panel.empty-height",
      "kind": "panel-empty",
      "selector": "$panels",
      "empty": "$emptyStates",
      "maxGap": 96,
      "owner": "the anchored panel's height cap (a max-height, never a fixed height) — NotificationBell / NotificationCenter, InlinePopover content"
    },
    {
      "id": "composer.last",
      "kind": "composer-last",
      "selector": "$composers",
      "column": "$composerColumns",
      "dock": "$composerDocks",
      "ignore": "[role=\"dialog\"], [role=\"menu\"], [role=\"listbox\"], [role=\"tooltip\"], [data-ui-listbox], [data-uic-popover]",
      "owner": "DockedColumn + ColumnDock (the page's one composer docked at the content column's bottom, spanning it); the page composing the column"
    },
    {
      "id": "section.empty-row",
      "kind": "section-empty",
      "selector": "$sections",
      "empty": "$emptyStates",
      "maxLines": 1,
      "owner": "PageSection empty (one row: the title and one quiet line) — never a heading over a 'nothing here' block"
    },
    {
      "id": "board.lane-surface",
      "kind": "surface-distinct",
      "selector": "$boardLanes",
      "owner": "BoardColumn lane surface"
    },
    {
      "id": "board.lane-columns",
      "kind": "columns",
      "selector": "$boards",
      "children": "[data-ui-board-lane]",
      "min": 1,
      "max": 12,
      "maxGap": 16,
      "owner": "CatalogGrid variant=\"lanes\" + BoardColumn h-full"
    },
    {
      "id": "text.cramped",
      "kind": "text-cramped",
      "selector": "body",
      "maxLines": 4,
      "minChars": 20,
      "owner": "the composite laying the text out (a callout/alert stacking title, body and action; a card column) — container queries, not page CSS"
    },
    {
      "id": "text.overlap",
      "kind": "text-overlap",
      "selector": "body",
      "tolerance": 2,
      "maxPerPage": 10,
      "owner": "the composite whose labels overflow their slot (flow/stat strips, chips, headers): wrap, ellipsis + title, or scroll inside the frame"
    },
    {
      "id": "text.clipped",
      "kind": "text-clipped",
      "selector": "body",
      "tolerance": 1,
      "owner": "the composite clipping the label: an ellipsis (title for the full text) or room for it",
      "scrollers": [
        {
          "selector": ".react-flow",
          "reason": "A node canvas viewport (xyflow, TypedNodeCanvas / WorkActivityGraph) pans: a node cut at its edge is reached by panning, like a row scrolled out of a list"
        }
      ]
    },
    {
      "id": "placeholder.squeezed",
      "kind": "placeholder-squeezed",
      "selector": "input[placeholder]:not([type=\"checkbox\"]):not([type=\"radio\"]):not([type=\"range\"]):not([type=\"file\"]):not([type=\"hidden\"]):not([type=\"color\"]), textarea[placeholder], [contenteditable=\"true\"]:has([data-placeholder]), [contenteditable=\"true\"][aria-placeholder]",
      "minEm": 10,
      "owner": "the row hosting the input (a composer's idle row, a toolbar): the input keeps its minimum width before chips; chips fold into a menu when narrow",
      "maxHidden": 0.5
    }
  ]
}
