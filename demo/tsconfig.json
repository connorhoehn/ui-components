{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@connorhoehn/ui-components/hooks": [
        "../src/hooks/index.ts"
      ],
      "@connorhoehn/ui-components/integrations/realtime-modules": [
        "../src/integrations/realtime-modules/index.ts"
      ],
      "@connorhoehn/ui-components/*": [
        "../src/components/*/index.ts"
      ],
      "@connorhoehn/ui-components": [
        "../src/index.ts"
      ],
      "@/*": [
        "../src/*"
      ],
      "@schemas/*": [
        "../schemas/*"
      ]
    }
  },
  "include": [
    "src",
    "../src"
  ]
}
