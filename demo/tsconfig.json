{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@connorhoehn/ui-components/*": ["../src/components/*/index.ts"],
      "@connorhoehn/ui-components": ["../src/index.ts"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "../src"]
}
