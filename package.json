{
  "name": "@connorhoehnslalom/ui-components",
  "version": "2.267.0",
  "description": "React component library for real-time collaborative applications — chat, presence, video, collaborative documents, pipeline editing and identity flows.",
  "keywords": [
    "react",
    "components",
    "ui",
    "realtime",
    "collaboration",
    "websocket",
    "video",
    "yjs",
    "design-system",
    "tailwind"
  ],
  "homepage": "https://github.com/connorhoehnslalom/ui-components#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pipelines": {
      "types": "./dist/pipelines.d.ts",
      "import": "./dist/pipelines.js",
      "require": "./dist/pipelines.cjs"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "import": "./dist/ingest.js",
      "require": "./dist/ingest.cjs"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "require": "./dist/observability.cjs"
    },
    "./doc-editor": {
      "types": "./dist/doc-editor.d.ts",
      "import": "./dist/doc-editor.js",
      "require": "./dist/doc-editor.cjs"
    },
    "./doc-types": {
      "types": "./dist/doc-types.d.ts",
      "import": "./dist/doc-types.js",
      "require": "./dist/doc-types.cjs"
    },
    "./diagram": {
      "types": "./dist/diagram.d.ts",
      "import": "./dist/diagram.js",
      "require": "./dist/diagram.cjs"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "import": "./dist/social.js",
      "require": "./dist/social.cjs"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js",
      "require": "./dist/graph.cjs"
    },
    "./social/rich-composer": {
      "types": "./dist/social/rich-composer.d.ts",
      "import": "./dist/social/rich-composer.js",
      "require": "./dist/social/rich-composer.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "require": "./dist/identity.cjs"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js",
      "require": "./dist/agents.cjs"
    },
    "./compute": {
      "types": "./dist/compute.d.ts",
      "import": "./dist/compute.js",
      "require": "./dist/compute.cjs"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js",
      "require": "./dist/video.cjs"
    },
    "./video-ivs": {
      "types": "./dist/video-ivs.d.ts",
      "import": "./dist/video-ivs.js",
      "require": "./dist/video-ivs.cjs"
    },
    "./styles.css": "./dist/ui-components.css",
    "./integrations/realtime-modules": {
      "types": "./dist/integrations/realtime-modules.d.ts",
      "import": "./dist/integrations/realtime-modules.js",
      "require": "./dist/integrations/realtime-modules.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/vite-build.mjs && npm run build:fix-subpath-dts",
    "build:fix-subpath-dts": "node scripts/fix-subpath-dts.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "prepare": "test -f dist/index.js || (vite build && npm run build:fix-subpath-dts && tsc --project tsconfig.build.json)",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "lint:static-styles": "node scripts/check-static-styles.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:node-controls": "node scripts/check-node-controls.mjs",
    "lint:hex-colors": "node scripts/check-hex-colors.mjs",
    "lint:readme": "node scripts/check-readme-imports.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/connorhoehnslalom/ui-components.git"
  },
