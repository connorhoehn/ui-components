{
  "name": "@connorhoehn/ui-components",
  "version": "2.30.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pipelines": {
      "types": "./dist/pipelines.d.ts",
      "import": "./dist/pipelines.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
      "import": "./dist/ingest.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./doc-editor": {
      "types": "./dist/doc-editor.d.ts",
      "import": "./dist/doc-editor.js"
    },
    "./social": {
      "types": "./dist/social.d.ts",
      "import": "./dist/social.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./video-ivs": {
      "types": "./dist/video-ivs.d.ts",
      "import": "./dist/video-ivs.js"
    },
    "./styles.css": "./dist/ui-components.css",
    "./integrations/realtime-modules": {
      "types": "./dist/integrations/realtime-modules.d.ts",
      "import": "./dist/integrations/realtime-modules.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm run build:fix-subpath-dts",
    "build:fix-subpath-dts": "node -e \"const fs=require('fs');const src='dist/realtime-modules.d.ts';const dst='dist/integrations/realtime-modules.d.ts';if(fs.existsSync(src))fs.copyFileSync(src,dst);\"",
    "build:types": "tsc --project tsconfig.build.json",
    "prepare": "test -f dist/index.js || (vite build && npm run build:fix-subpath-dts && tsc --project tsconfig.build.json)",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:static-styles": "node scripts/check-static-styles.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/connorhoehn/ui-components.git"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@connorhoehn/realtime-modules": ">=0.3.0",
    "@tiptap/react": "^3.0.0",
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "recharts": "^3.0.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "@connorhoehn/realtime-modules": {
      "optional": true
    }
  },
  "devDependencies": {
    "@connorhoehn/realtime-modules": "file:../realtime-modules",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.59.1",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@tiptap/extension-collaboration": "^3.22.3",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-mention": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-task-item": "^3.22.3",
    "@tiptap/extension-task-list": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@tiptap/y-tiptap": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.10.2",
    "jsdom": "^28.1.0",
    "lib0": "^0.2.117",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.14.1",
    "recharts": "^3.8.1",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  }
}
